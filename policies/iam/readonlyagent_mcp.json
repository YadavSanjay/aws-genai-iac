{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectReadOnlyInspectViaMCP",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "elasticloadbalancing:Describe*",
        "application-autoscaling:Describe*",
        "autoscaling:Describe*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "ecs:Describe*",
        "ecs:List*",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:GetLifecyclePolicy",
        "ecr:GetRepositoryPolicy",
        "s3:List*",
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetAccountPublicAccessBlock",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "backup:Describe*",
        "backup:List*",
        "logs:Describe*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:StopQuery",
        "logs:GetQueryResults",
        "logs:ListTagsForResource",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueues",
        "sqs:ListQueueTags",
        "sns:Get*",
        "sns:List*",
        "scheduler:Get*",
        "scheduler:List*",
        "events:Describe*",
        "events:List*",
        "route53:Get*",
        "route53:List*",
        "servicediscovery:Get*",
        "servicediscovery:List*",
        "acm:Describe*",
        "acm:List*",
        "kms:Describe*",
        "kms:List*",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecrets",
        "secretsmanager:GetResourcePolicy",
        "ssm:Describe*",
        "ssm:ListTagsForResource",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:GetTemplate",
        "cloudtrail:Describe*",
        "cloudtrail:Get*",
        "cloudtrail:List*",
        "tag:Get*",
        "iam:Get*",
        "iam:List*",
        "iam:GenerateServiceLastAccessedDetails",
        "iam:SimulatePrincipalPolicy",
        "iam:SimulateCustomPolicy",
        "elasticfilesystem:Describe*",
        "batch:Describe*",
        "batch:List*",
        "ce:Get*",
        "ce:Describe*",
        "ce:List*",
        "budgets:ViewBudget"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:CalledViaAWSMCP": "aws-mcp.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyAnythingNotReadOnlyViaMCP",
      "Effect": "Deny",
      "NotAction": [
        "ec2:Describe*",
        "elasticloadbalancing:Describe*",
        "application-autoscaling:Describe*",
        "autoscaling:Describe*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "ecs:Describe*",
        "ecs:List*",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:GetLifecyclePolicy",
        "ecr:GetRepositoryPolicy",
        "s3:List*",
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetAccountPublicAccessBlock",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "backup:Describe*",
        "backup:List*",
        "logs:Describe*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:StopQuery",
        "logs:GetQueryResults",
        "logs:ListTagsForResource",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueues",
        "sqs:ListQueueTags",
        "sns:Get*",
        "sns:List*",
        "scheduler:Get*",
        "scheduler:List*",
        "events:Describe*",
        "events:List*",
        "route53:Get*",
        "route53:List*",
        "servicediscovery:Get*",
        "servicediscovery:List*",
        "acm:Describe*",
        "acm:List*",
        "kms:Describe*",
        "kms:List*",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecrets",
        "secretsmanager:GetResourcePolicy",
        "ssm:Describe*",
        "ssm:ListTagsForResource",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:GetTemplate",
        "cloudtrail:Describe*",
        "cloudtrail:Get*",
        "cloudtrail:List*",
        "tag:Get*",
        "iam:Get*",
        "iam:List*",
        "iam:GenerateServiceLastAccessedDetails",
        "iam:SimulatePrincipalPolicy",
        "iam:SimulateCustomPolicy",
        "elasticfilesystem:Describe*",
        "batch:Describe*",
        "batch:List*",
        "ce:Get*",
        "ce:Describe*",
        "ce:List*",
        "budgets:ViewBudget"
      ],
      "Resource": "*",
      "Condition": {
        "Bool": {
          "aws:ViaAWSMCPService": "true"
        }
      }
    }
  ]
}
