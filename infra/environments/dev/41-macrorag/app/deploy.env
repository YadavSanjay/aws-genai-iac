# MacroRAG per-deploy image tags — the compose env-file that rides in the S3
# deploy bundle (NOT user-data), so an image bump never reprovisions the host.
#
# scripts/deploy_macrorag_bundle.py substitutes ${REGISTRY} (the in-account ECR
# host, derived from STS at upload time — which is why the real account id is not
# committed here) and uploads the result to s3://<corpus>/deploy/deploy.env.
# app-deploy.sh passes it as compose's SECOND --env-file, so these win over the
# image placeholders in docker-compose.aws.yml.
#
# TO BUMP AN IMAGE: edit a tag below, re-run scripts/deploy_macrorag_bundle.py,
# then `systemctl restart app.service` on the host (SSM). No Terraform, no
# reprovision. Tags are immutable (never :latest); the two app images share the
# MacroRAG source SHA, the sidecars are mirrored upstream versions.
MACRORAG_IMAGE=${REGISTRY}/genai-dev/macrorag:arm64-a1624e8
MACRORAG_UI_IMAGE=${REGISTRY}/genai-dev/macrorag-ui:arm64-3ded531
MACRORAG_REDIS_IMAGE=${REGISTRY}/genai-dev/redis:7-alpine
MACRORAG_OTEL_IMAGE=${REGISTRY}/genai-dev/otel-collector:0.116.1
RAGINFER_TIMEOUT_S=1800